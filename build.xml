<project name="wattzap" default="fatjar" basedir=".">
    <description>Wattzap Ant build</description>

    <property name="src" location="src"/>
    <property name="build" location="target/bin"/>
    <property name="dist" location="target"/>

    <!-- Legacy embedded ANT+ USB libraries are deliberately excluded.
         If Java sources still reference them, compilation will identify them. -->
    <path id="master-classpath">
        <fileset dir="lib" includes="*.jar">
            <exclude name="usb4java*.jar"/>
            <exclude name="jformica*.jar"/>
        </fileset>
        <fileset dir="lib/java1.7" includes="*.jar">
            <exclude name="usb4java*.jar"/>
            <exclude name="jformica*.jar"/>
        </fileset>
    </path>

    <target name="init">
        <mkdir dir="${build}"/>
    </target>

    <target name="compile" depends="init" description="Compile Wattzap">
        <!-- Compile for Java 21. -->
        <javac srcdir="${src}" destdir="${build}"
               debug="true"
               debuglevel="lines,vars,source" includeantruntime="false">
            <classpath refid="master-classpath"/>
        </javac>
    </target>

    <!-- One JAR containing Wattzap and its Java dependencies. VLC remains external.
         Keep the properties directory alongside the JAR for existing configuration. -->
    <target name="fatjar" depends="compile"
            description="Build executable target/wattzap-all.jar">
        <mkdir dir="${dist}"/>
        <jar destfile="${dist}/wattzap-all.jar" duplicate="preserve">
            <!-- Local classes first, including overrides of third-party classes. -->
            <fileset dir="${build}">
                <exclude name="**/*Test.class"/>
                <exclude name="META-INF/**"/>
            </fileset>
            <!-- These were previously found through the properties/ classpath entry.
                 Put resource bundles and Log4j config at the JAR root. -->
            <fileset dir="properties">
                <include name="MessageBundle*.properties"/>
                <include name="log4j.properties"/>
                <include name="log4j.xml"/>
            </fileset>
            <zipgroupfileset dir="lib" includes="*.jar"
                             excludes="usb4java*.jar,jformica*.jar"/>
            <zipgroupfileset dir="lib/java1.7" includes="*.jar"
                             excludes="usb4java*.jar,jformica*.jar"/>
            <manifest>
                <attribute name="Main-Class" value="com.wattzap.Main"/>
            </manifest>
        </jar>
    </target>

    <target name="dist" depends="compile" description="Build original layout">
        <mkdir dir="${dist}/wattzap/lib"/>
        <jar destfile="${dist}/wattzap/lib/wattzap.jar">
            <fileset dir="${build}">
                <exclude name="**/*Test.class"/>
                <exclude name="org/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="linux" depends="dist" description="Build original Linux distribution">
        <copy todir="${dist}/wattzap/lib">
            <fileset dir="lib" includes="*.jar"
                     excludes="usb4java*.jar,jformica*.jar"/>
            <fileset dir="lib/java1.7" includes="*.jar"
                     excludes="usb4java*.jar,jformica*.jar"/>
        </copy>
        <copy todir="${dist}/wattzap/lib/org">
            <fileset dir="lib/org"/>
        </copy>
        <copy todir="${dist}/wattzap/properties">
            <fileset dir="properties"/>
        </copy>
        <copy todir="${dist}/wattzap/icons">
            <fileset dir="icons"/>
        </copy>
        <copy file="wattzap.sh" tofile="${dist}/wattzap/wattzap.sh"/>
        <chmod file="${dist}/wattzap/wattzap.sh" perm="755"/>
        <tar destfile="${dist}/wattzap.tar" basedir="${dist}/wattzap"/>
        <gzip destfile="${dist}/wattzap.tar.gz" src="${dist}/wattzap.tar"/>
    </target>

    <target name="clean" description="Delete generated files">
        <delete dir="${dist}"/>
    </target>
</project>
